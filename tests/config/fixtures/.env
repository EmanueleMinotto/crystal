# comment line
APP_NAME=crystal
export APP_ENV=dev
APP_DEBUG=true
APP_CACHE=(false)
APP_SECRET=null
APP_EMPTY=empty
BLANK=
SPACED = spaced value   # inline comment
HASH=a#b
SINGLE='literal ${APP_NAME}\n'
DOUBLE="${APP_NAME} \"quoted\"\tescaped \${APP_NAME}"
URL=${APP_NAME}.${APP_ENV}/path
MISSING_REF=x${NOT_DEFINED_ANYWHERE}y
MULTILINE="first
second"
PRESET=from-file
